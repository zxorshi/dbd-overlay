{
  "name": "dbd-overlay",
  "version": "0.2.1",
  "description": "Free, open source overlay toolkit for Dead by Daylight. Not affiliated with Behaviour Interactive.",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "update-data": "node scripts/update-data.mjs",
    "update-assets": "node scripts/update-assets.mjs",
    "test": "node --test",
    "dist": "npx electron-builder@25 --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "dev.dbdoverlay.app",
    "productName": "DBD Overlay",
    "files": [
      "src/**",
      "data/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "npmRebuild": false,
    "asar": false,
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "DBD-Overlay-Setup.exe",
      "shortcutName": "DBD Overlay",
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "zxorshi",
      "repo": "dbd-overlay",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "electron-updater": "^6.8.11",
    "tesseract.js": "^5.1.1",
    "uiohook-napi": "^1.5.5"
  }
}
