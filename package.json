{
  "name": "dbd-overlay",
  "version": "0.1.1",
  "description": "Free, open source overlay toolkit for Dead by Daylight. Not affiliated with Behaviour Interactive.",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "update-data": "node scripts/update-data.mjs",
    "update-assets": "node scripts/update-assets.mjs",
    "test": "node --test",
    "dist": "npx electron-builder@25 --win portable"
  },
  "build": {
    "appId": "dev.dbdoverlay.app",
    "productName": "DBD Overlay",
    "files": [
      "src/**",
      "data/**",
      "assets/**"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "npmRebuild": false,
    "asar": false,
    "portable": {
      "artifactName": "DBD-Overlay.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "tesseract.js": "^5.1.1",
    "uiohook-napi": "^1.5.5"
  }
}
